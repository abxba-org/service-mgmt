#!/usr/bin/env bash
set -euo pipefail

HOME_PORT=8080
MGMT=14321

serve_txt() {
  tailscale serve status
}

# True when both / and /agent-vault paths are served to their respective backends.
paths_configured() {
  local serve serve_home serve_agent
  serve=$({ serve_txt; } | grep -E '\|-- /[[:space:]]*proxy|\|-- /agent-vault[[:space:]]*proxy|\|-- /\*[[:space:]]*proxy')
  serve_home=$(echo "$serve" | grep -q '\|-- /[[:space:]]*proxy http://127\.0\.0\.1:'"${HOME_PORT}" && echo true || echo false)
  serve_agent=$(echo "$serve" | grep -q '\|-- /agent-vault[[:space:]]*proxy http://127\.0\.0\.1:'"${MGMT}" && echo true || echo false)
  [[ "$serve_home" == "true" && "$serve_agent" == "true" ]] || { echo "$serve" >&2; return 1; }
  true
}
verify() {
  echo "vault-mgmt: verifying paths configuration"
  paths_configured
  echo "vault-mgmt: verification passed"
}

start() {
  echo "vault-mgmt: starting vault servers"
  vault server -dev -dev-root-token-id=root -dev-listen-address="127.0.0.1:${HOME_PORT}" > /tmp/vault-home.log 2>&1 &
  vault server -dev -dev-root-token-id=root -dev-listen-address="127.0.0.1:${MGMT}" > /tmp/vault-mgmt.log 2>&1 &
  sleep 3
  echo "vault-mgmt: started"
}

stop() {
  echo "vault-mgmt: stopping vault servers"
  pkill -f "vault server" || true
  echo "vault-mgmt: stopped"
}

status() {
  echo "vault-mgmt: status"
  echo "home port: ${HOME_PORT}"
  echo "mgmt port: ${MGMT}"
}

case "${1:-}" in
  verify)
    verify
    ;;
  start)
    start
    ;;
  stop)
    stop
    ;;
  status)
    status
    ;;
  *)
    echo "Usage: vault-mgmt {verify|start|stop|status}"
    exit 1
    ;;
esac
